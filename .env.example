# ===================================================
# SAATHI CARE - Environment Configuration Template
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=saathi_care_secure_jwt_secret_change_in_production_key_2026
SESSION_SECRET=saathi_care_session_secret_hash_key_998877

# Database File Path (Default: ./data/saathi_care.db)
DB_PATH=./data/saathi_care.db

# Email Notifications (Nodemailer SMTP)
# Leave blank to run in honest fallback / simulation mode with in-app notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SAATHI CARE <notifications@saathicare.health>"

# Optional Gemini AI API Key for Medication Explainer
# If left blank, the built-in clinical rule engine provides instant safe medication guidance
GEMINI_API_KEY=
